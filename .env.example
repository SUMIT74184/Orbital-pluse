# Local (docker compose mongo): mongodb://localhost:27017/dsa_tracker
# Vercel: your MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/dsa_tracker

# Random secret, 32+ characters. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated emails that can open /admin (manage content, see users & analytics).
ADMIN_EMAILS=you@example.com

# Email reminders (Resend). Without a verified domain Resend only delivers to your own Resend account's address.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="Orbit-Plus <reminders@yourdomain.com>"
# Public URL used in email links. On Vercel it falls back to the production domain.
APP_URL=http://localhost:3000
# Shared with the GitHub Actions workflow that calls /api/cron/reminders hourly. Generate: openssl rand -hex 32
CRON_SECRET=change-me
